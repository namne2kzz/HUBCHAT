# HUB — .env for the PRODUCTION server.
#
# Copy to `.env` next to docker-compose.prod.yml on the server, then fill in real values.
# How this differs from .env.example (local): it adds HUB_TAG + GHCR_OWNER, and MinIO
# uses a public endpoint instead of host.docker.internal.
#
# This file holds secrets — chmod 600, never commit it, never bake it into an image.

# ─── Image registry ──────────────────────────────────────────────────────────
# GitHub user/org that owns the GHCR packages (the part after ghcr.io/).
GHCR_OWNER=namne2kzz

# THE ONLY LINE CD REWRITES — it drives all seven services at once.
# Value is the first 7 characters of the git SHA. Leave "latest" initially; CD overwrites it.
HUB_TAG=latest

# ─── SSO — these three MUST match DASHBOARD/.env on the same server ──────────
JWT_SECRET=REPLACE_min_32_chars_must_match_dashboard_exactly
JWT_ISSUER=dashboard-api
JWT_AUDIENCE=dashboard-spa

# Token for HUB → DASHBOARD /internal/v1/*.
INTERNAL_API_TOKEN=REPLACE_min_32_chars_must_match_dashboard

# Token for DASHBOARD → HUB Chat /internal/channels/*.
HUB_CHAT_INTERNAL_TOKEN=REPLACE_min_32_chars_must_match_dashboard

# ─── DASHBOARD internal API ──────────────────────────────────────────────────
# On the same Docker host, use the service name over hub-net. Do NOT use
# host.docker.internal — that only exists on Docker Desktop, not on a Linux server.
DASHBOARD_INTERNAL_BASEURL=http://dashboard-api:8080/internal/v1/

# ─── PostgreSQL (one container, database-per-service) ────────────────────────
POSTGRES_USER=hub
POSTGRES_PASSWORD=REPLACE_postgres_password
POSTGRES_DB=hub_directory

# ─── Redis + RabbitMQ — shared with the DASHBOARD stack over hub-net ─────────
# Service names come from DASHBOARD's docker-compose.prod.yml.
REDIS_CONNECTION=dashboard-redis:6379
RABBITMQ_HOST=dashboard-rabbitmq
RABBITMQ_USER=REPLACE_same_rabbit_user_as_dashboard
RABBITMQ_PASSWORD=REPLACE_same_rabbit_password_as_dashboard

# ─── MinIO (file attachments) ────────────────────────────────────────────────
MINIO_ROOT_USER=REPLACE_minio_user
MINIO_ROOT_PASSWORD=REPLACE_minio_password_min_8_chars
# Endpoint the browser uses for presigned URLs — must be reachable from the internet.
# No scheme prefix; the SDK derives it from Minio__UseSsl.
MINIO_PUBLIC_ENDPOINT=hub-storage.example.com
MINIO_USE_SSL=true

# ─── Public ports (the reverse proxy targets these) ──────────────────────────
GATEWAY_PORT=8080
VIEW_PORT=4202

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
