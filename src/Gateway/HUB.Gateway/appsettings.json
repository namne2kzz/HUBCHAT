{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "CHANGE_THIS_SECRET_MIN_32_CHARS_LONG!",
    "Issuer": "dashboard",
    "Audience": "dashboard-clients"
  },
  "ReverseProxy": {
    "Routes": {
      "dashboard-gateway": {
        "ClusterId": "dashboard-gateway",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/directory/{**catch-all}"
        }
      },
      "chat-channels": {
        "ClusterId": "chat",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/channels/{**catch-all}"
        }
      },
      "chat-messages": {
        "ClusterId": "chat",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/messages/{**catch-all}"
        }
      },
      "realtime-hub": {
        "ClusterId": "realtime",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "media-files": {
        "ClusterId": "media",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        }
      },
      "presence": {
        "ClusterId": "realtime",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/presence"
        }
      }
    },
    "Clusters": {
      "dashboard-gateway": {
        "Destinations": {
          "primary": {
            "Address": "http://dashboard-gateway:8080/"
          }
        }
      },
      "chat": {
        "Destinations": {
          "primary": {
            "Address": "http://chat:8080/"
          }
        }
      },
      "realtime": {
        "Destinations": {
          "primary": {
            "Address": "http://realtime:8080/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://notification:8080/"
          }
        }
      },
      "media": {
        "Destinations": {
          "primary": {
            "Address": "http://media:8080/"
          }
        }
      }
    }
  }
}
