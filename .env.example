# ─────────────────────────────────────────────────────────────────────────────
# HUB environment — copy to `.env` (NOT committed) and fill real values.
# The .env is consumed by docker-compose and injected into each container.
# ─────────────────────────────────────────────────────────────────────────────

# ── SSO: shared JWT secret — MUST equal DASHBOARD's JwtSettings:Secret ──────────
JWT_SECRET=change-me-must-match-dashboard-exactly-min-32-chars
JWT_ISSUER=dashboard
JWT_AUDIENCE=dashboard-clients

# ── Service-to-service token for calling DASHBOARD /internal/v1/* ───────────────
# MUST equal DASHBOARD's InternalApi:Token. (HUB → DASHBOARD direction)
INTERNAL_API_TOKEN=change-me-shared-with-dashboard-internal-api

# ── Token for DASHBOARD → HUB Chat /internal/channels/* ─────────────────────────
# MUST equal DASHBOARD's HubChat:InternalToken. (DASHBOARD → HUB direction)
HUB_CHAT_INTERNAL_TOKEN=change-me-shared-with-dashboard-hub-chat

# ── DASHBOARD internal API base URL (reachable from HUB containers) ─────────────
# On the same Docker host use host.docker.internal; in prod use the internal DNS name.
DASHBOARD_INTERNAL_BASEURL=http://host.docker.internal:5080/internal/v1/

# ── PostgreSQL (1 container, database-per-service) ─────────────────────────────
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=hub_directory

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_CONNECTION=redis:6379

# ── RabbitMQ (HUB's own broker) ────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=hub
RABBITMQ_PASSWORD=change-me-rabbit

# ── MinIO (object storage) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=hub
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
